# ═══════════════════════════════════════════════════════════════════════════
# ELSHADAI CAKE CREATIONS — ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored and must never be committed.
#
# Note: there is deliberately NO service-role key here. Review submission and
# throttling run inside database functions, and owner actions run under the
# owner's own login, so this website never needs a key that can bypass
# database security.
# ═══════════════════════════════════════════════════════════════════════════

# Your Supabase project URL.
# Supabase dashboard → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=

# The PUBLIC anonymous key. Safe to expose in the browser — it is restricted by
# row level security and cannot read customer email addresses.
# Supabase dashboard → Project Settings → API Keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# A long random string used to hash submitter IP addresses for throttling.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret and do not change it after launch, or existing throttling
# records stop matching.
REVIEW_HASH_SALT=
