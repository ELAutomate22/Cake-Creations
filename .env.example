# ═══════════════════════════════════════════════════════════════════════════
# ELSHADAI CAKE CREATIONS — ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored and must never be committed.
#
# Until these are set, the website runs perfectly well — the reviews section
# simply says it is not connected yet. Nothing else is affected.
#
# Reviews live in Cloudflare D1. Note that NONE of these are NEXT_PUBLIC_:
# unlike the Supabase setup this replaced, there is no key that is safe to hand
# to a browser. D1 has no row level security, so anything able to reach it can
# do anything to it. The website reads reviews through its own /api/reviews
# endpoint, and the token below never leaves the server.
# ═══════════════════════════════════════════════════════════════════════════

# Cloudflare account ID.
# Cloudflare dashboard -> Workers & Pages -> Account details
CLOUDFLARE_ACCOUNT_ID=

# The D1 database ID.
#   npx wrangler d1 list
CLOUDFLARE_D1_DATABASE_ID=

# An API token scoped to D1 only.
# Cloudflare dashboard -> My Profile -> API Tokens -> Create Token
#   -> Custom token, Permissions: Account | D1 | Edit
#   -> Account Resources: include only this account
# Treat it like a password. If it leaks, revoke it on that same page.
CLOUDFLARE_API_TOKEN=

# A long random string used to hash submitter addresses for rate limiting.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret, and do not change it after launch or existing throttling
# records stop matching.
REVIEW_HASH_SALT=

# ── Cloudflare R2, for reference photographs ──────────────────────────────
# Optional. Without these the request form still works, but a customer who
# attaches photographs is told they cannot be received rather than having them
# silently dropped.
#
# Create the bucket:  Cloudflare dashboard -> R2 -> Create bucket
# Keep it PRIVATE. Nothing here needs public access; images are served through
# short-lived signed links.
R2_BUCKET_NAME=

# R2 -> Manage R2 API Tokens -> Create API token
#   Permissions: Object Read & Write, this bucket only
# The token page shows an Access Key ID and a Secret Access Key.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── The admin area ────────────────────────────────────────────────────────
# Without these, /admin says it is not configured and refuses every request.
#
# One password, because one person runs the business. There are no accounts,
# so there is nothing to manage and no password-reset flow to get wrong.
# Make it long — it is the only thing between the internet and every
# customer's name, email, phone number and address.
ADMIN_PASSWORD=

# Signs the admin session cookie. Any long random string; changing it signs
# everyone out immediately, which is how to revoke a session.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ── Email, through Resend ─────────────────────────────────────────────────
# Optional. Without these the admin area still works and every send is
# recorded, but messages are marked "not_configured" instead of going out.
#
# resend.com -> API Keys. Sending permission is enough.
RESEND_API_KEY=

# Who the message is from. Must be on a domain verified in Resend, or the
# send is rejected: a personal Gmail or Outlook address cannot be used here,
# because nobody outside those companies can publish the DNS records that
# prove the right to send as them.
FROM_EMAIL=
FROM_NAME=Elshadai Cake Creations

# Where a customer's reply is delivered, if that is not the sending address.
# Any inbox that is actually read, personal ones included -- this one needs no
# DNS records, because it is an address to write to rather than an identity to
# send as. Leave empty and replies go to FROM_EMAIL.
REPLY_TO_EMAIL=

# ── Stripe ────────────────────────────────────────────────────────────────
# Without these the site still works: quote pages explain that payment will be
# arranged directly rather than showing a button that does not work.
#
# Use the TEST key until the end-to-end checks in docs/payments.md have passed.
# Developers -> API keys
STRIPE_SECRET_KEY=

# Developers -> Webhooks -> add https://YOUR-DOMAIN/api/stripe/webhook
# subscribed to checkout.session.completed only, then copy the signing secret.
# Live and test webhooks are separate; a live key with a test secret rejects
# every real payment.
STRIPE_WEBHOOK_SECRET=

# Where Stripe returns the customer to, and the base for secure quote links.
APP_BASE_URL=

# Protects the nightly cleanup endpoint. Any long random string.
CRON_SECRET=
